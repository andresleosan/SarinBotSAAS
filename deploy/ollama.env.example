# Configuracion del proceso Ollama NATIVO en la Mac, no del contenedor Next.
# Formato estricto KEY=value: sin export, comillas, expansion ni comentarios al final.
# El script lee solo las claves documentadas; este archivo no contiene secretos.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NO_CLOUD=1
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_QUEUE=4
OLLAMA_DEBUG=0
