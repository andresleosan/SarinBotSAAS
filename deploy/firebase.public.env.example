# Solo las cuatro variables publicas incorporadas a JavaScript durante el build.
# Copia a firebase.public.env y completa con la configuracion real del proyecto.
# No introducir FIREBASE_ADMIN_*, SUPERADMIN_UID ni tokens Cloudflare aqui.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
