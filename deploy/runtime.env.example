# Copiar a .env.production SOLO en el host que ejecutara Next.
# Compose usa formato raw: valores sin comillas, sin interpolacion ni comentarios inline.
# Clave privada en UNA linea con secuencias literales \n entre sus lineas PEM.
# No copiar este archivo a una imagen Docker ni compartir su version completada.
FIREBASE_ADMIN_CREDENTIAL_MODE=cert
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternativa ADC: cambiar el modo a adc y dejar email/clave anteriores vacios.
# Montar el directorio runtime privado SOLO LECTURA; ruta dentro del contenedor:
# GOOGLE_APPLICATION_CREDENTIALS=/run/sarin/google/adc.json
# No usar ADC humano de desarrollo como identidad permanente de produccion.
GOOGLE_APPLICATION_CREDENTIALS=
SUPERADMIN_UID=
SARIN_TUNNEL_URL=https://sarin-engine.example.invalid/v1/chat/completions
OLLAMA_MAIN_MODEL=qwen3:32b
OLLAMA_VISION_MODEL=qwen3-vl:8b
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Proveedor inicial: ollama (predeterminado), deepseek o gemini; chat de negocio/onboarding.
# La selección guardada por el superadministrador en /admin prevalece sobre este valor.
# Las claves de API se guardan solo en el runtime privado.
SARIN_CHAT_PROVIDER=ollama
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# true solo tras verificar que el proyecto de esta clave tiene facturación activa.
GEMINI_BILLING_VERIFIED=false
# Perfil informativo de pruebas, separado del proveedor que atiende a negocios.
# Para nivel gratuito: proyecto distinto sin facturación; solo datos ficticios.
# No hereda GEMINI_API_KEY, no consulta Google ni genera contenido desde Sarin.
GEMINI_TEST_MODEL=gemini-3.5-flash-lite
GEMINI_TEST_API_KEY=
# WhatsApp oficial: no habilitar antes de registrar y verificar un número real.
# Credenciales y cifrado solo servidor; ver docs/whatsapp-cloud-api.md.
# JSON en UNA línea, sin comillas envolventes: {"PHONE_ID":{"wabaId":"WABA_ID","accessToken":"..."}}
WHATSAPP_ENABLED=false
WHATSAPP_RETENTION_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CONTENT_KEY=
WHATSAPP_PHONE_CREDENTIALS_JSON=
# Tras activar WA, mantener RETENTION_ENABLED=true incluso si ENABLED=false.
MAX_CONCURRENT_LLM_SLOTS=4
MAX_QUEUED_LLM_REQUESTS=64
LLM_QUEUE_TIMEOUT_MS=120000
LLM_REQUEST_TIMEOUT_MS=120000
# Precios iniciales para 7, 15 y 30 dias; Firestore prevalece si estan guardados.
WEEKLY_PRICE_COP=20000
FORTNIGHTLY_PRICE_COP=35000
MONTHLY_PRICE_COP=59900
SARIN_PUBLIC_BOOKING_ORIGIN=https://sarinbotsaas.pages.dev
