# Copia este archivo a .env.local. Nunca subas .env.local al repositorio.
# Node.js 24 LTS; ejecuta una sola instancia Node para la cola global en memoria.

# Firebase Client: configuración pública del proyecto (no credenciales Admin).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin: solo servidor. Cuenta de servicio de mínimo privilegio.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIAL_MODE=cert
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternativa sin claves: cambiar el modo a adc y eliminar las dos variables
# de certificado anteriores. Usar ADC de impersonación en desarrollo; ver README.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/application_default_credentials.json

# UID exacto de Firebase Auth del administrador, nunca un email ni NEXT_PUBLIC.
SUPERADMIN_UID=

# URL OpenAI-compatible de TU Ollama local detrás de Cloudflare Access.
# Remoto exige HTTPS y ambos headers CF. Loopback admite HTTP solo para desarrollo.
SARIN_TUNNEL_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MAIN_MODEL=qwen3:32b
OLLAMA_VISION_MODEL=qwen3-vl:8b
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Proveedor inicial; /admin permite cambiar entre IA local, DeepSeek y Gemini.
# La selección del panel prevalece sobre este valor.
# deepseek/gemini envían el contexto de negocio/conversación a su API externa.
SARIN_CHAT_PROVIDER=ollama
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# true solo tras verificar que el proyecto de esta clave tiene facturación activa.
GEMINI_BILLING_VERIFIED=false

# WhatsApp oficial: preparado, desactivado hasta registrar un número real.
# Nunca NEXT_PUBLIC. JSON: {"PHONE_NUMBER_ID":{"wabaId":"WABA_ID","accessToken":"..."}}
# CONTENT_KEY: 32 bytes aleatorios en base64. Conservar privada durante la retención.
WHATSAPP_ENABLED=false
WHATSAPP_RETENTION_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CONTENT_KEY=
WHATSAPP_PHONE_CREDENTIALS_JSON=
# Al activar WhatsApp, RETENTION_ENABLED=true; conservarlo al pausar los envíos.
# dev:local/test:journey deshabilitan ambos procesos y vacían las credenciales.

# Los modelos OLLAMA_* deben estar descargados en la Mac. Se rechazan tags :cloud.
# Elige 1 para admitir una sola inferencia simultánea.
# Máximo 4, de acuerdo con OLLAMA_NUM_PARALLEL en la Mac.
MAX_CONCURRENT_LLM_SLOTS=4
MAX_QUEUED_LLM_REQUESTS=64
LLM_QUEUE_TIMEOUT_MS=120000
LLM_REQUEST_TIMEOUT_MS=120000

# Precios iniciales para 7, 15 y 30 días; Firestore prevalece cuando están guardados.
# Los bancos reales se configuran desde /admin (no hay cuentas demo).
WEEKLY_PRICE_COP=20000
FORTNIGHTLY_PRICE_COP=35000
MONTHLY_PRICE_COP=59900
SARIN_PUBLIC_BOOKING_ORIGIN=https://sarinbotsaas.pages.dev

# Solo emuladores locales, NUNCA configurar en producción:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Candidato aislado: soporte SarinBot por WhatsApp de plataforma/YCloud.
# Solo nombres y valores inertes. No copiar este archivo como configuración productiva.
# La web /soporte funciona independientemente de activar recepción WhatsApp.
# Todas las flags nuevas permanecen apagadas y los tres presupuestos en cero.
PLATFORM_WHATSAPP_RECEIVE_ENABLED=false
PLATFORM_WHATSAPP_RETENTION_ENABLED=false
PLATFORM_WHATSAPP_PROCESSING_ENABLED=false
PLATFORM_WHATSAPP_TRANSCRIPTION_ENABLED=false
PLATFORM_WHATSAPP_AUDIO_ENABLED=false
PLATFORM_WHATSAPP_AI_ENABLED=false
PLATFORM_WHATSAPP_SEND_ENABLED=false
PLATFORM_WHATSAPP_AUDIO_DAILY_BUDGET_MICROS=0
PLATFORM_WHATSAPP_GENERATION_DAILY_BUDGET_MICROS=0
PLATFORM_WHATSAPP_SEND_DAILY_BUDGET_MICROS=0

# Secretos/alcance exclusivos del canal, solo en almacén privado del servidor y Worker.
# Las claves de contenido, vínculo, soporte y propuesta de pago son distintas:
# 32 bytes aleatorios en base64 canónico. Conservar la de contenido mientras
# exista contenido cifrado. Vínculo, soporte y pago tienen marcadores duraderos:
# un cambio de esas claves falla cerrado (503).
PLATFORM_YCLOUD_WEBHOOK_SECRET=
PLATFORM_YCLOUD_API_KEY=
PLATFORM_WHATSAPP_CONTENT_KEY=
PLATFORM_WHATSAPP_LINK_HMAC_KEY=
PLATFORM_SUPPORT_KEY=
ADMIN_PAYMENT_ACTION_KEY=
PLATFORM_WHATSAPP_WABA_ID=
PLATFORM_WHATSAPP_PHONE_E164=
PLATFORM_WHATSAPP_PHONE_NUMBER_ID=

# Políticas JSON versionadas: dejar vacías hasta confirmar tarifas vigentes en USD/UTC,
# cota de cada etapa y modelos reales devueltos por DeepSeek. Sin mapeo, cerrar generación.
# No usar precios de ejemplo como autorización de gasto.
PLATFORM_WHATSAPP_TARIFF_POLICY=
PLATFORM_WHATSAPP_GENERATION_POLICY=

# Diagnóstico acotado: apagado; parámetros solo tras autorización de una prueba concreta.
PLATFORM_YCLOUD_DIAGNOSTIC_ENABLED=false
# PLATFORM_YCLOUD_DIAGNOSTIC_RUN_ID=
# PLATFORM_YCLOUD_DIAGNOSTIC_EXPIRES_AT=
# PLATFORM_YCLOUD_DIAGNOSTIC_SENDER=
# PLATFORM_YCLOUD_DIAGNOSTIC_NONCE=
