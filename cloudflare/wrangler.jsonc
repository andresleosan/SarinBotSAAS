{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sarin-bot-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "FIREBASE_ADMIN_CREDENTIAL_MODE": "adc",
    "FIREBASE_ADMIN_PROJECT_ID": "sarinbotsaas",
    "FIREBASE_WIF_AUDIENCE": "//iam.googleapis.com/projects/153690559048/locations/global/workloadIdentityPools/sarin-cloudflare/providers/worker-oidc",
    "FIREBASE_WIF_SERVICE_ACCOUNT_EMAIL": "sarin-runtime@sarinbotsaas.iam.gserviceaccount.com",
    "WHATSAPP_ENABLED": "false",
    "WHATSAPP_RETENTION_ENABLED": "false",
    "SARIN_DATA_BACKEND": "d1",
    "SARIN_PUBLIC_BOOKING_ORIGIN": "https://sarinbotsaas.pages.dev",
    "SARIN_MAINTENANCE": "false",
    "PILOT_AI_BUDGET_ENFORCED": "true"
  },
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "SARIN_DB", "database_name": "sarin-bot-data", "database_id": "b0cc530c-fce3-4758-a945-3e111091e09b", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "SARIN_FILES", "bucket_name": "sarin-bot-files" }],
  "containers": [{
    "class_name": "SarinApp",
    "scheduling_policy": "default",
    "image": "../Dockerfile",
    "image_build_context": "..",
    "instance_type": "basic",
    "max_instances": 1,
    "observability": { "enabled": false },
    "image_vars": {
      "NEXT_PUBLIC_FIREBASE_API_KEY": "",
      "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "",
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "",
      "NEXT_PUBLIC_FIREBASE_APP_ID": ""
    }
  }],
  "durable_objects": { "bindings": [{ "name": "SARIN_APP", "class_name": "SarinApp" }, { "name": "SARIN_IDENTITY", "class_name": "SarinIdentity" }] },
  "exports": { "SarinApp": { "type": "durable-object", "storage": "sqlite" }, "SarinIdentity": { "type": "durable-object", "storage": "sqlite" } }
}
